---
import { siteData } from '../data/site';
import { footerData } from '../data/footer';

const currentYear = new Date().getFullYear();
const { sections, socialAriaLabels, copyright } = footerData;
---

<footer class="bg-secondary-900 text-neutral-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Main footer content -->
    <div class="grid grid-cols-1 gap-10 py-12 md:grid-cols-2 lg:grid-cols-4 lg:py-16">
      <!-- Company info -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2 text-xl font-bold text-white">
          <svg class="h-8 w-8" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect width="32" height="32" rx="8" class="fill-primary-500" />
            <path d="M16 8l4 8-4 8-4-8z" fill="white" opacity="0.9" />
          </svg>
          <span>{siteData.name}</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-neutral-400">
          {siteData.description}
        </p>
        <!-- Social links -->
        <div class="mt-6 flex gap-3">
          <a href={siteData.social[0]} class="flex h-10 w-10 items-center justify-center rounded-lg bg-secondary-800 text-neutral-400 transition-colors hover:bg-primary-600 hover:text-white" aria-label={socialAriaLabels.facebook} target="_blank" rel="noopener noreferrer">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" /></svg>
          </a>
          <a href={siteData.social[1]} class="flex h-10 w-10 items-center justify-center rounded-lg bg-secondary-800 text-neutral-400 transition-colors hover:bg-primary-600 hover:text-white" aria-label={socialAriaLabels.instagram} target="_blank" rel="noopener noreferrer">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" /></svg>
          </a>
          <a href={siteData.social[2]} class="flex h-10 w-10 items-center justify-center rounded-lg bg-secondary-800 text-neutral-400 transition-colors hover:bg-primary-600 hover:text-white" aria-label={socialAriaLabels.linkedin} target="_blank" rel="noopener noreferrer">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
          </a>
          <a href={siteData.social[3]} class="flex h-10 w-10 items-center justify-center rounded-lg bg-secondary-800 text-neutral-400 transition-colors hover:bg-primary-600 hover:text-white" aria-label={socialAriaLabels.twitter} target="_blank" rel="noopener noreferrer">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
          </a>
        </div>
      </div>

      <!-- Services links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">{sections.services.heading}</h3>
        <ul class="mt-4 space-y-3">
          {sections.services.links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-neutral-400 transition-colors hover:text-primary-400">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">{sections.company.heading}</h3>
        <ul class="mt-4 space-y-3">
          {sections.company.links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-neutral-400 transition-colors hover:text-primary-400">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <h3 class="mt-8 text-sm font-semibold uppercase tracking-wider text-white">{sections.legal.heading}</h3>
        <ul class="mt-4 space-y-3">
          {sections.legal.links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-neutral-400 transition-colors hover:text-primary-400">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact info -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">{sections.contact.heading}</h3>
        <ul class="mt-4 space-y-4">
          <li class="flex gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span class="text-sm text-neutral-400">
              {siteData.address.street}<br />
              {siteData.address.city}, {siteData.address.state}
            </span>
          </li>
          <li class="flex gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <a href={`tel:${siteData.telephone.replace(/\s/g, '')}`} class="text-sm text-neutral-400 transition-colors hover:text-primary-400">
              {siteData.telephone}
            </a>
          </li>
          <li class="flex gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <a href={`mailto:${siteData.email}`} class="text-sm text-neutral-400 transition-colors hover:text-primary-400">
              {siteData.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-secondary-800 py-6 text-center">
      <p class="text-sm text-neutral-500">
        &copy; {currentYear} {siteData.name}. {copyright}
      </p>
    </div>
  </div>
</footer>
