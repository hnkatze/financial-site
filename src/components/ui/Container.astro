---
import type { ContainerProps } from '../../types/index';

interface Props extends ContainerProps {}

const { size = 'lg', class: className = '' } = Astro.props;

const sizeClasses: Record<string, string> = {
  sm: 'max-w-3xl',
  md: 'max-w-5xl',
  lg: 'max-w-7xl',
  xl: 'max-w-[90rem]',
};
---

<div class:list={['mx-auto w-full px-4 sm:px-6 lg:px-8', sizeClasses[size], className]}>
  <slot />
</div>
