---
import type { SectionHeadingProps } from '../../types/index';

interface Props extends SectionHeadingProps {}

const { title, subtitle, badge, align = 'center' } = Astro.props;

const alignClasses = align === 'center' ? 'text-center' : 'text-left';
---

<div class:list={[alignClasses, 'mb-12 lg:mb-16']}>
  {badge && (
    <span class="mb-3 inline-block rounded-full bg-primary-100 px-4 py-1.5 text-sm font-semibold text-primary-700">
      {badge}
    </span>
  )}
  <h2 class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl lg:text-5xl font-heading">
    {title}
  </h2>
  {subtitle && (
    <p class:list={[
      'mt-4 text-lg text-neutral-600',
      align === 'center' ? 'mx-auto max-w-2xl' : 'max-w-2xl',
    ]}>
      {subtitle}
    </p>
  )}
</div>
