---
import Button from '../ui/Button.astro';
---

<form id="contact-form" class="space-y-6" novalidate>
  {/* Name field */}
  <div>
    <label for="name" class="block text-sm font-semibold text-neutral-900 mb-2">
      Nombre completo <span class="text-error-500" aria-hidden="true">*</span>
    </label>
    <input
      type="text"
      id="name"
      name="name"
      required
      minlength="2"
      autocomplete="name"
      placeholder="Ej: María Fernández"
      class="peer w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-neutral-900 placeholder-neutral-400 transition-colors duration-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 focus:outline-none min-h-[2.75rem]"
      aria-describedby="name-error"
    />
    <p id="name-error" class="mt-1.5 hidden text-sm text-error-500 peer-[&:not(:placeholder-shown):invalid]:block">
      Por favor ingresa tu nombre completo.
    </p>
  </div>

  {/* Email field */}
  <div>
    <label for="email" class="block text-sm font-semibold text-neutral-900 mb-2">
      Correo electrónico <span class="text-error-500" aria-hidden="true">*</span>
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      autocomplete="email"
      placeholder="correo@ejemplo.com"
      class="peer w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-neutral-900 placeholder-neutral-400 transition-colors duration-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 focus:outline-none min-h-[2.75rem]"
      aria-describedby="email-error"
    />
    <p id="email-error" class="mt-1.5 hidden text-sm text-error-500 peer-[&:not(:placeholder-shown):invalid]:block">
      Por favor ingresa un correo electrónico válido.
    </p>
  </div>

  {/* Phone field */}
  <div>
    <label for="phone" class="block text-sm font-semibold text-neutral-900 mb-2">
      Teléfono
    </label>
    <input
      type="tel"
      id="phone"
      name="phone"
      autocomplete="tel"
      placeholder="+504 9999-0000"
      class="w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-neutral-900 placeholder-neutral-400 transition-colors duration-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 focus:outline-none min-h-[2.75rem]"
    />
  </div>

  {/* Subject select */}
  <div>
    <label for="subject" class="block text-sm font-semibold text-neutral-900 mb-2">
      Asunto
    </label>
    <select
      id="subject"
      name="subject"
      class="w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-neutral-900 transition-colors duration-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 focus:outline-none min-h-[2.75rem]"
    >
      <option value="">Selecciona un asunto</option>
      <option value="prestamos">Préstamos Personales</option>
      <option value="creditos">Créditos Empresariales</option>
      <option value="inversiones">Inversiones y Ahorro</option>
      <option value="seguros">Seguros y Protección</option>
      <option value="asesoria">Asesoría Financiera</option>
      <option value="otro">Otro</option>
    </select>
  </div>

  {/* Message field */}
  <div>
    <label for="message" class="block text-sm font-semibold text-neutral-900 mb-2">
      Mensaje <span class="text-error-500" aria-hidden="true">*</span>
    </label>
    <textarea
      id="message"
      name="message"
      required
      minlength="10"
      rows="5"
      placeholder="Cuéntanos cómo podemos ayudarte..."
      class="peer w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-neutral-900 placeholder-neutral-400 transition-colors duration-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 focus:outline-none resize-y"
      aria-describedby="message-error"
    ></textarea>
    <p id="message-error" class="mt-1.5 hidden text-sm text-error-500 peer-[&:not(:placeholder-shown):invalid]:block">
      Por favor ingresa un mensaje de al menos 10 caracteres.
    </p>
  </div>

  {/* Submit button */}
  <div>
    <Button class="w-full sm:w-auto" size="lg">
      Enviar Mensaje
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="ml-2 size-5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
      </svg>
    </Button>
  </div>

  {/* Success message — shown via JS after form submit */}
  <div id="form-success" class="hidden rounded-2xl border border-success-500/30 bg-success-500/10 p-6 text-center" role="alert">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto mb-3 size-12 text-success-500" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
    </svg>
    <h3 class="text-lg font-bold text-neutral-900">¡Mensaje enviado!</h3>
    <p class="mt-1 text-sm text-neutral-600">
      Esto es una demostración. En producción, tu mensaje sería procesado por nuestro equipo.
    </p>
  </div>
</form>

<script is:inline>
  document.getElementById('contact-form')?.addEventListener('submit', function(e) {
    e.preventDefault();
    var form = e.target;
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    form.style.display = 'none';
    document.getElementById('form-success').classList.remove('hidden');
  });
</script>
