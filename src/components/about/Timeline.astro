---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { aboutContent } from '../../data/content/about';

const { timeline } = aboutContent;
const milestones = timeline.milestones;
---

<section class="py-20 lg:py-28 bg-white">
  <Container size="md">
    <SectionHeading
      title={timeline.title}
      subtitle={timeline.subtitle}
      badge={timeline.badge}
    />

    <div class="relative">
      {/* Vertical timeline line */}
      <div class="absolute left-4 top-0 bottom-0 w-0.5 animate-draw-line lg:left-1/2 lg:-translate-x-px" aria-hidden="true"></div>

      <ol class="relative space-y-12">
        {milestones.map((milestone, index) => (
          <li class:list={[
            'animate-fade-in-up relative pl-12 lg:pl-0',
            index % 2 === 0 ? 'lg:pr-[calc(50%+2rem)] lg:animate-slide-in-left' : 'lg:pl-[calc(50%+2rem)] lg:animate-slide-in-right',
          ]}>
            {/* Timeline dot */}
            <div class:list={[
              'absolute left-2.5 top-1 size-3 rounded-full border-2 border-primary-500 bg-white animate-dot-pulse lg:top-1',
              index % 2 === 0 ? 'lg:left-auto lg:right-[calc(50%-0.375rem)]' : 'lg:left-[calc(50%-0.375rem)]',
            ]} aria-hidden="true"></div>

            {/* Content card */}
            <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-soft">
              <span class="inline-block rounded-full bg-primary-100 px-3 py-1 text-sm font-bold text-primary-700">
                {milestone.year}
              </span>
              <h3 class="mt-3 text-lg font-bold text-neutral-900">
                {milestone.title}
              </h3>
              <p class="mt-2 text-sm text-neutral-600 leading-relaxed">
                {milestone.description}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Container>
</section>
