---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import { aboutContent } from '../../data/content/about';

const { values } = aboutContent;
---

<section class="py-20 lg:py-28 bg-white">
  <Container>
    <SectionHeading
      title={values.title}
      subtitle={values.subtitle}
      badge={values.badge}
    />

    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
      {values.items.map((value) => (
        <li class="animate-fade-in-up">
          <Card variant="elevated" class="h-full hover:border-primary-300 transition-colors duration-300">
            <div class="mb-4 flex size-14 items-center justify-center rounded-2xl bg-primary-100 text-primary-600">
              <Fragment set:html={value.icon} />
            </div>
            <h3 class="mb-2 text-lg font-bold text-neutral-900">
              {value.title}
            </h3>
            <p class="text-sm text-neutral-600 leading-relaxed">
              {value.description}
            </p>
          </Card>
        </li>
      ))}
    </ul>
  </Container>
</section>
