---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import { team } from '../../data/team';
import { aboutContent } from '../../data/content/about';

const { team: teamContent } = aboutContent;
---

<section class="py-20 lg:py-28 bg-neutral-50">
  <Container>
    <SectionHeading
      title={teamContent.title}
      subtitle={teamContent.subtitle}
      badge={teamContent.badge}
    />

    <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {team.map((member) => (
        <li class="animate-fade-in-up">
          <Card variant="elevated" class="h-full text-center hover:border-primary-300 transition-colors duration-300">
            {/* Avatar placeholder with initials */}
            <div class="mx-auto mb-4 flex size-20 items-center justify-center rounded-full bg-gradient-to-br from-primary-500 to-secondary-600 text-2xl font-bold text-white" aria-hidden="true">
              {member.name.split(' ').map(n => n[0]).slice(0, 2).join('')}
            </div>
            <h3 class="text-lg font-bold text-neutral-900">
              {member.name}
            </h3>
            <p class="mt-1 text-sm font-medium text-primary-600">
              {member.role}
            </p>
            <p class="mt-3 text-sm text-neutral-600 leading-relaxed">
              {member.bio}
            </p>
            {member.social?.linkedin && (
              <a
                href={member.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`LinkedIn de ${member.name}`}
                class="mt-4 inline-flex items-center justify-center size-10 rounded-full text-neutral-500 hover:text-primary-600 hover:bg-primary-50 transition-colors"
              >
                <svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              </a>
            )}
          </Card>
        </li>
      ))}
    </ul>
  </Container>
</section>
