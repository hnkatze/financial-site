---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
---

<section class="relative overflow-hidden animate-hue-shift py-20 lg:py-28">
  <!-- Decorative elements -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <svg class="absolute -top-10 -left-10 h-64 w-64 opacity-10 animate-float" viewBox="0 0 256 256" fill="none">
      <circle cx="128" cy="128" r="128" fill="white" />
    </svg>
    <svg class="absolute -bottom-12 -right-12 h-80 w-80 opacity-10" viewBox="0 0 320 320" fill="none">
      <circle cx="160" cy="160" r="160" fill="white" />
    </svg>
    <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 48px 48px;"></div>
  </div>

  <Container size="md" class="relative z-10 text-center">
    <div class="animate-fade-in-up">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl font-heading">
        Listo para dar el siguiente paso?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-primary-100/90">
        Nuestro equipo de asesores esta disponible para ayudarte a encontrar la solucion financiera perfecta para tus necesidades.
      </p>
      <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <Button href="/contact" size="lg" class="bg-white! text-primary-700! hover:bg-neutral-100! shadow-lg animate-btn-shimmer animate-pulse-glow">
          Contactar un Asesor
        </Button>
        <Button href="/calculator" variant="outline" size="lg" class="border-white/80! text-white! hover:bg-white/10!">
          Calcular mi Prestamo
        </Button>
      </div>
    </div>
  </Container>
</section>
