---
import Container from '../ui/Container.astro';
import { partners } from '../../data/partners';
import { homeContent } from '../../data/content/home';

const { partners: partnersContent } = homeContent;
---

<section class="py-16 lg:py-20 bg-white border-y border-neutral-200">
  <Container>
    <div class="mb-10 text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-neutral-500">
        {partnersContent.title}
      </p>
    </div>

    <div class="overflow-hidden" role="marquee" aria-label={partnersContent.marqueeAriaLabel}>
      <div class="animate-marquee gap-8 md:gap-12 lg:gap-16">
        {partners.map((partner) => (
          <div class="flex-shrink-0 flex items-center justify-center grayscale opacity-60 transition-all duration-300 hover:grayscale-0 hover:opacity-100">
            <div
              class="flex h-12 items-center justify-center rounded-lg px-5 text-sm font-bold text-neutral-600 select-none whitespace-nowrap"
              title={partner.name}
            >
              {partner.name}
            </div>
          </div>
        ))}
        {partners.map((partner) => (
          <div class="flex-shrink-0 flex items-center justify-center grayscale opacity-60 transition-all duration-300 hover:grayscale-0 hover:opacity-100" aria-hidden="true">
            <div
              class="flex h-12 items-center justify-center rounded-lg px-5 text-sm font-bold text-neutral-600 select-none whitespace-nowrap"
              title={partner.name}
            >
              {partner.name}
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
