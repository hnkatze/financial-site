---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';

const features = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" /></svg>`,
    title: 'Tasas Competitivas',
    description: 'Ofrecemos las mejores tasas del mercado hondureno, con condiciones transparentes y sin costos ocultos para tu tranquilidad.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>`,
    title: 'Aprobacion Rapida',
    description: 'Proceso de aprobacion agil y eficiente. Recibe respuesta en menos de 24 horas y tu desembolso en tiempo record.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" /></svg>`,
    title: 'Asesoria Personalizada',
    description: 'Un equipo de expertos financieros dedicados a entender tus necesidades y disenarte un plan a la medida.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>`,
    title: 'Seguridad Garantizada',
    description: 'Regulados por la CNBS con los mas altos estandares de seguridad. Tu patrimonio esta protegido con nosotros.',
  },
];
---

<section class="py-20 lg:py-28 bg-neutral-50">
  <Container>
    <SectionHeading
      title="Por que elegir FinanzaPro"
      subtitle="Mas de 15 anos respaldando el crecimiento financiero de miles de hondurenos con soluciones confiables y accesibles."
      badge="Nuestras Ventajas"
    />

    <ul class="stagger-fade-in-up grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4" role="list">
      {features.map((feature) => (
        <li class="animate-fade-in-up">
          <Card variant="elevated" class="h-full text-center hover:border-primary-300 transition-colors duration-300">
            <div class="mx-auto mb-4 flex size-14 items-center justify-center rounded-2xl bg-primary-100 text-primary-600">
              <Fragment set:html={feature.icon} />
            </div>
            <h3 class="mb-2 text-lg font-bold text-neutral-900">
              {feature.title}
            </h3>
            <p class="text-sm text-neutral-600 leading-relaxed">
              {feature.description}
            </p>
          </Card>
        </li>
      ))}
    </ul>
  </Container>
</section>
