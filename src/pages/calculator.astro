---
import Layout from '../layouts/Layout.astro';
import Container from '../components/ui/Container.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import LoanCalculator from '../components/islands/LoanCalculator.tsx';
import { generateWebAppJsonLd, generateBreadcrumbJsonLd } from '../lib/seo';

const webAppJsonLd = generateWebAppJsonLd(
  'Calculadora de Préstamos — FinanzaPro',
  'Calcula tu cuota mensual, total a pagar e intereses con nuestra calculadora de préstamos gratuita.',
  'https://www.example.com/calculator',
);

const breadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: 'Inicio', url: 'https://www.example.com/' },
  { name: 'Calculadora', url: 'https://www.example.com/calculator' },
]);

const jsonLd = [webAppJsonLd, breadcrumbJsonLd];
---

<Layout
  title="Calculadora de Préstamos — FinanzaPro | Simula tu Cuota Mensual"
  description="Calcula tu cuota mensual, total a pagar e intereses con nuestra calculadora de préstamos gratuita. Simulación en tiempo real con tabla de amortización."
  url="https://www.example.com/calculator"
  jsonLd={jsonLd}
>
  {/* Page hero */}
  <section class="relative overflow-hidden bg-gradient-to-br from-primary-600 via-secondary-700 to-secondary-900 py-20 sm:py-24 lg:py-32">
    <!-- Decorative elements -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
      <svg class="absolute -top-16 -right-16 h-72 w-72 opacity-10 animate-float" viewBox="0 0 288 288" fill="none">
        <circle cx="144" cy="144" r="144" fill="white" />
      </svg>
      <svg class="absolute -bottom-12 -left-12 h-56 w-56 opacity-10" viewBox="0 0 224 224" fill="none">
        <circle cx="112" cy="112" r="112" fill="white" />
      </svg>
    </div>

    <Container class="relative z-10 text-center">
      <div class="animate-fade-in-up">
        <span class="mb-4 inline-block rounded-full border border-white/20 bg-white/10 px-5 py-2 text-sm font-medium text-primary-100 backdrop-blur-sm">
          Herramienta gratuita
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl font-heading">
          Calculadora de Préstamos
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100/90">
          Simula tu préstamo en tiempo real. Calcula tu cuota mensual, el total a pagar y los intereses con nuestra herramienta interactiva.
        </p>
      </div>
    </Container>
  </section>

  {/* Calculator section */}
  <section class="py-20 lg:py-28 bg-neutral-50">
    <Container size="lg">
      <SectionHeading
        title="Simula tu Préstamo"
        subtitle="Ajusta el monto, la tasa de interés y el plazo para conocer tu cuota mensual estimada y el detalle de amortización."
        badge="Calculadora"
      />

      {/* Static placeholder visible before hydration */}
      <div class="mx-auto max-w-5xl">
        <LoanCalculator client:visible />
      </div>
    </Container>
  </section>

  {/* Tips section */}
  <section class="py-20 lg:py-28 bg-white">
    <Container>
      <SectionHeading
        title="Consejos al Solicitar un Préstamo"
        subtitle="Toma decisiones informadas con estos consejos de nuestros expertos financieros."
        badge="Información"
      />

      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
        <li class="animate-fade-in-up rounded-2xl border border-neutral-200 bg-neutral-50 p-6">
          <div class="mb-4 flex size-12 items-center justify-center rounded-xl bg-primary-100 text-primary-600">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-neutral-900 mb-2">
            Compara tasas de interés
          </h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Antes de comprometerte, compara las tasas de interés entre varias instituciones financieras. Una diferencia de uno o dos puntos porcentuales puede representar un ahorro significativo.
          </p>
        </li>

        <li class="animate-fade-in-up rounded-2xl border border-neutral-200 bg-neutral-50 p-6">
          <div class="mb-4 flex size-12 items-center justify-center rounded-xl bg-primary-100 text-primary-600">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-neutral-900 mb-2">
            Elige el plazo adecuado
          </h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Un plazo más largo reduce tu cuota mensual, pero aumenta los intereses totales. Busca un equilibrio entre una cuota cómoda y el menor costo total del préstamo.
          </p>
        </li>

        <li class="animate-fade-in-up rounded-2xl border border-neutral-200 bg-neutral-50 p-6">
          <div class="mb-4 flex size-12 items-center justify-center rounded-xl bg-primary-100 text-primary-600">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-neutral-900 mb-2">
            Revisa tu capacidad de pago
          </h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            La cuota mensual no debería superar el 30-35% de tus ingresos mensuales. Asegúrate de tener un presupuesto que incluya todos tus gastos antes de solicitar un préstamo.
          </p>
        </li>

        <li class="animate-fade-in-up rounded-2xl border border-neutral-200 bg-neutral-50 p-6">
          <div class="mb-4 flex size-12 items-center justify-center rounded-xl bg-primary-100 text-primary-600">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-neutral-900 mb-2">
            Lee la letra pequeña
          </h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Revisa comisiones de apertura, seguros obligatorios y penalizaciones por pago anticipado. El costo total del préstamo va más allá de la tasa de interés publicada.
          </p>
        </li>

        <li class="animate-fade-in-up rounded-2xl border border-neutral-200 bg-neutral-50 p-6">
          <div class="mb-4 flex size-12 items-center justify-center rounded-xl bg-primary-100 text-primary-600">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-neutral-900 mb-2">
            Considera pagos anticipados
          </h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Si tu contrato lo permite, hacer abonos extraordinarios al capital reduce significativamente los intereses totales y el tiempo de pago del préstamo.
          </p>
        </li>

        <li class="animate-fade-in-up rounded-2xl border border-neutral-200 bg-neutral-50 p-6">
          <div class="mb-4 flex size-12 items-center justify-center rounded-xl bg-primary-100 text-primary-600">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-neutral-900 mb-2">
            Busca asesoría profesional
          </h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Un asesor financiero puede ayudarte a elegir el producto más adecuado para tu situación. En FinanzaPro ofrecemos asesoría sin compromiso.
          </p>
        </li>
      </ul>

      {/* CTA to contact */}
      <div class="mt-16 text-center animate-fade-in-up">
        <p class="mb-6 text-lg text-neutral-600">
          ¿Listo para solicitar tu préstamo? Nuestros asesores te guiarán en el proceso.
        </p>
        <a
          href="/contact"
          class="inline-flex min-h-[44px] items-center justify-center rounded-xl bg-primary-600 px-8 py-3 text-base font-semibold text-white shadow-lg transition-colors hover:bg-primary-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
        >
          Habla con un Asesor
        </a>
      </div>
    </Container>
  </section>
</Layout>
