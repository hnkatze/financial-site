---
import Layout from '../layouts/Layout.astro';
import Container from '../components/ui/Container.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import LoanCalculator from '../components/islands/LoanCalculator.tsx';
import { generateWebAppJsonLd, generateBreadcrumbJsonLd } from '../lib/seo';
import { siteData } from '../data/site';
import { pagesSeo, breadcrumbLabels } from '../data/pages-seo';
import { calculatorContent } from '../data/content/calculator';

const webAppJsonLd = generateWebAppJsonLd(
  pagesSeo.calculator.title,
  pagesSeo.calculator.description,
  `${siteData.url}/calculator`,
);

const breadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: breadcrumbLabels.home, url: `${siteData.url}/` },
  { name: breadcrumbLabels.calculator, url: `${siteData.url}/calculator` },
]);

const jsonLd = [webAppJsonLd, breadcrumbJsonLd];
const { hero, calculator, tips, cta } = calculatorContent;
---

<Layout
  title={pagesSeo.calculator.title}
  description={pagesSeo.calculator.description}
  url={`${siteData.url}/calculator`}
  jsonLd={jsonLd}
>
  {/* Page hero */}
  <section class="relative overflow-hidden bg-gradient-to-br from-primary-600 via-secondary-700 to-secondary-900 py-20 sm:py-24 lg:py-32">
    <!-- Decorative elements -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
      <svg class="absolute -top-16 -right-16 h-72 w-72 opacity-10 animate-float" viewBox="0 0 288 288" fill="none">
        <circle cx="144" cy="144" r="144" fill="white" />
      </svg>
      <svg class="absolute -bottom-12 -left-12 h-56 w-56 opacity-10" viewBox="0 0 224 224" fill="none">
        <circle cx="112" cy="112" r="112" fill="white" />
      </svg>
    </div>

    <Container class="relative z-10 text-center">
      <div class="animate-fade-in-up">
        <span class="mb-4 inline-block rounded-full border border-white/20 bg-white/10 px-5 py-2 text-sm font-medium text-primary-100 backdrop-blur-sm">
          {hero.badge}
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl font-heading">
          {hero.title}
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100/90">
          {hero.subtitle}
        </p>
      </div>
    </Container>
  </section>

  {/* Calculator section */}
  <section class="py-20 lg:py-28 bg-neutral-50">
    <Container size="lg">
      <SectionHeading
        title={calculator.title}
        subtitle={calculator.subtitle}
        badge={calculator.badge}
      />

      {/* Static placeholder visible before hydration */}
      <div class="mx-auto max-w-5xl">
        <LoanCalculator client:visible />
      </div>
    </Container>
  </section>

  {/* Tips section */}
  <section class="py-20 lg:py-28 bg-white">
    <Container>
      <SectionHeading
        title={tips.title}
        subtitle={tips.subtitle}
        badge={tips.badge}
      />

      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {tips.items.map((tip) => (
          <li class="animate-fade-in-up rounded-2xl border border-neutral-200 bg-neutral-50 p-6">
            <div class="mb-4 flex size-12 items-center justify-center rounded-xl bg-primary-100 text-primary-600">
              <Fragment set:html={tip.icon} />
            </div>
            <h3 class="text-lg font-bold text-neutral-900 mb-2">
              {tip.title}
            </h3>
            <p class="text-sm text-neutral-600 leading-relaxed">
              {tip.description}
            </p>
          </li>
        ))}
      </ul>

      {/* CTA to contact */}
      <div class="mt-16 text-center animate-fade-in-up">
        <p class="mb-6 text-lg text-neutral-600">
          {cta.text}
        </p>
        <a
          href={cta.buttonHref}
          class="inline-flex min-h-[44px] items-center justify-center rounded-xl bg-primary-600 px-8 py-3 text-base font-semibold text-white shadow-lg transition-colors hover:bg-primary-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
        >
          {cta.buttonText}
        </a>
      </div>
    </Container>
  </section>
</Layout>
