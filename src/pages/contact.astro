---
import Layout from '../layouts/Layout.astro';
import Container from '../components/ui/Container.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import { generateLocalBusinessJsonLd, generateBreadcrumbJsonLd } from '../lib/seo';
import { siteData } from '../data/site';
import { pagesSeo, breadcrumbLabels } from '../data/pages-seo';
import { contactContent } from '../data/content/contact';

const localBusinessJsonLd = generateLocalBusinessJsonLd(siteData);
const breadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: breadcrumbLabels.home, url: `${siteData.url}/` },
  { name: breadcrumbLabels.contact, url: `${siteData.url}/contact` },
]);

const jsonLd = [localBusinessJsonLd, breadcrumbJsonLd];
const { hero, form, sidebar } = contactContent;
---

<Layout
  title={pagesSeo.contact.title}
  description={pagesSeo.contact.description}
  url={`${siteData.url}/contact`}
  jsonLd={jsonLd}
>
  {/* Page hero */}
  <section class="relative overflow-hidden bg-gradient-to-br from-primary-700 via-secondary-800 to-secondary-900 py-20 sm:py-24 lg:py-32">
    <!-- Decorative elements -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
      <svg class="absolute -top-16 -right-16 h-72 w-72 opacity-10 animate-float" viewBox="0 0 288 288" fill="none">
        <circle cx="144" cy="144" r="144" fill="white" />
      </svg>
      <svg class="absolute -bottom-12 -left-12 h-56 w-56 opacity-10" viewBox="0 0 224 224" fill="none">
        <circle cx="112" cy="112" r="112" fill="white" />
      </svg>
    </div>

    <Container class="relative z-10 text-center">
      <div class="animate-fade-in-up">
        <span class="mb-4 inline-block rounded-full border border-white/20 bg-white/10 px-5 py-2 text-sm font-medium text-primary-100 backdrop-blur-sm">
          {hero.badge}
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl font-heading">
          {hero.title}
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100/90">
          {hero.subtitle}
        </p>
      </div>
    </Container>
  </section>

  {/* Contact content */}
  <section class="py-20 lg:py-28 bg-neutral-50">
    <Container>
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-5 lg:gap-16">
        {/* Contact form */}
        <div class="lg:col-span-3">
          <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-soft sm:p-8 lg:p-10">
            <h2 class="text-2xl font-bold text-neutral-900 mb-2">
              {form.sectionTitle}
            </h2>
            <p class="mb-8 text-neutral-600">
              {form.sectionSubtitle}
            </p>
            <ContactForm />
          </div>
        </div>

        {/* Contact info sidebar */}
        <div class="lg:col-span-2 space-y-8">
          {/* Address */}
          <div class="animate-fade-in-up rounded-2xl border border-neutral-200 bg-white p-6 shadow-soft">
            <div class="flex items-start gap-4">
              <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-primary-100 text-primary-600">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-neutral-900">{sidebar.address.title}</h3>
                <p class="mt-1 text-sm text-neutral-600 leading-relaxed">
                  {siteData.address.street}<br />
                  {siteData.address.city}, {siteData.address.state}<br />
                  {sidebar.address.countryLabel}
                </p>
              </div>
            </div>
          </div>

          {/* Phone */}
          <div class="animate-fade-in-up rounded-2xl border border-neutral-200 bg-white p-6 shadow-soft">
            <div class="flex items-start gap-4">
              <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-primary-100 text-primary-600">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-neutral-900">{sidebar.phone.title}</h3>
                <a href={`tel:${siteData.telephone.replace(/\s/g, '')}`} class="mt-1 block text-sm text-primary-600 hover:text-primary-700 transition-colors">
                  {siteData.telephone}
                </a>
                <p class="mt-1 text-xs text-neutral-500">
                  {sidebar.phone.hours}
                </p>
              </div>
            </div>
          </div>

          {/* Email */}
          <div class="animate-fade-in-up rounded-2xl border border-neutral-200 bg-white p-6 shadow-soft">
            <div class="flex items-start gap-4">
              <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-primary-100 text-primary-600">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-neutral-900">{sidebar.email.title}</h3>
                <a href={`mailto:${siteData.email}`} class="mt-1 block text-sm text-primary-600 hover:text-primary-700 transition-colors">
                  {siteData.email}
                </a>
                <p class="mt-1 text-xs text-neutral-500">
                  {sidebar.email.responseTime}
                </p>
              </div>
            </div>
          </div>

          {/* Social links */}
          <div class="animate-fade-in-up rounded-2xl border border-neutral-200 bg-white p-6 shadow-soft">
            <h3 class="font-bold text-neutral-900 mb-4">{sidebar.social.title}</h3>
            <div class="flex gap-3">
              {/* Facebook */}
              <a
                href={siteData.social[0]}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={sidebar.social.ariaLabels.facebook}
                class="flex size-11 items-center justify-center rounded-xl text-neutral-500 hover:text-primary-600 hover:bg-primary-50 transition-colors"
              >
                <svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
                </svg>
              </a>

              {/* Instagram */}
              <a
                href={siteData.social[1]}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={sidebar.social.ariaLabels.instagram}
                class="flex size-11 items-center justify-center rounded-xl text-neutral-500 hover:text-primary-600 hover:bg-primary-50 transition-colors"
              >
                <svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
                </svg>
              </a>

              {/* LinkedIn */}
              <a
                href={siteData.social[2]}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={sidebar.social.ariaLabels.linkedin}
                class="flex size-11 items-center justify-center rounded-xl text-neutral-500 hover:text-primary-600 hover:bg-primary-50 transition-colors"
              >
                <svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              </a>

              {/* Twitter/X */}
              <a
                href={siteData.social[3]}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={sidebar.social.ariaLabels.twitter}
                class="flex size-11 items-center justify-center rounded-xl text-neutral-500 hover:text-primary-600 hover:bg-primary-50 transition-colors"
              >
                <svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              </a>
            </div>
          </div>

          {/* Map placeholder */}
          <div class="animate-fade-in-up rounded-2xl border border-neutral-200 bg-neutral-100 overflow-hidden">
            <div class="flex aspect-[4/3] items-center justify-center p-6 text-center">
              <div>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto mb-3 size-12 text-neutral-400" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z" />
                </svg>
                <p class="text-sm font-medium text-neutral-500">
                  {siteData.address.street}
                </p>
                <p class="mt-1 text-xs text-neutral-400">
                  {siteData.address.city}, Honduras
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>
</Layout>
